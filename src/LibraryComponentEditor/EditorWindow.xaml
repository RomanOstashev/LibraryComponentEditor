<Window x:Class="LibraryComponentEditor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Component Editor" Language="ru-RU"
        Style="{DynamicResource Renga.WPF.Style.Window}"
        Foreground="{DynamicResource Renga.WPF.Styles.Brush.Glyph}"
        MinWidth="720" MinHeight="500" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        WindowStartupLocation="Manual" ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Renga.WPF.Styles;component/Themes/Renga.Implicit.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PaneCaption" TargetType="TextBlock">
                <Setter Property="Padding" Value="4,3,4,4" />
            </Style>
            <Style x:Key="PaneSurface" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Renga.WPF.Styles.Brush.ControlBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Renga.WPF.Styles.Brush.ControlBorder}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="140" MaxWidth="260" />
            <ColumnDefinition Width="9" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="9" />
            <ColumnDefinition Width="1.1*" MinWidth="150" MaxWidth="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="9" />
            <RowDefinition Height="*" MaxHeight="200" />
        </Grid.RowDefinitions>

        <DockPanel Grid.RowSpan="3">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneCaption}" Text="Дерево построений" />
            <Border x:Name="ConstructionPane" Style="{StaticResource PaneSurface}" />
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneCaption}" Text="3D-вид" />
            <Border x:Name="WorkSurface" Style="{StaticResource PaneSurface}" />
        </DockPanel>

        <DockPanel Grid.Column="2" Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneCaption}" Text="Исходники" />
            <Border x:Name="SourcesPane" Style="{StaticResource PaneSurface}" />
        </DockPanel>

        <DockPanel Grid.Column="4" Grid.RowSpan="3">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneCaption}" Text="Параметры" />
            <Border x:Name="ParametersPane" Style="{StaticResource PaneSurface}" />
        </DockPanel>
    </Grid>
</Window>
