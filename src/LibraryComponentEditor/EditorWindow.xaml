<Window x:Class="LibraryComponentEditor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Component Editor" Language="ru-RU"
        Style="{DynamicResource Renga.WPF.Style.Window}"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        WindowStartupLocation="Manual" ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Renga.WPF.Styles;component/Themes/Renga.Implicit.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <GroupBox Header="Пример параметров компонента" Width="350" Margin="20"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Margin="12">
                <Label Content="_Наименование" Target="{Binding ElementName=ComponentName}" />
                <TextBox x:Name="ComponentName" Text="Насос" />
                <Label Content="_Типоразмер" Target="{Binding ElementName=ComponentSize}" Margin="0,10,0,0" />
                <ComboBox x:Name="ComponentSize" SelectedIndex="0">
                    <ComboBoxItem Content="DN 50" />
                    <ComboBoxItem Content="DN 80" />
                </ComboBox>
                <CheckBox Content="Показывать порты" IsChecked="True" Margin="0,16,0,0" />
            </StackPanel>
        </GroupBox>
    </ScrollViewer>
</Window>
