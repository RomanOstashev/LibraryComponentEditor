<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <DependenciesDir>$(MSBuildThisFileDirectory)..\..\.deps</DependenciesDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Renga.NET.PluginUtility">
      <HintPath>$(DependenciesDir)\Renga.NET.PluginUtility.dll</HintPath>
    </Reference>
    <Reference Include="Interop.Renga">
      <HintPath>$(DependenciesDir)\Interop.Renga.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="Renga.WPF.Styles">
      <HintPath>$(DependenciesDir)\Renga.WPF.Styles.dll</HintPath>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <None Update="LibraryComponentEditor.rndesc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
